NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/reports.db

# Use long random values in production.
CASE_CODE_SECRET=replace-with-at-least-32-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes

# A moderator account is bootstrapped on first startup if it does not exist.
MODERATOR_EMAIL=moderator@example.com
MODERATOR_PASSWORD=change-this-immediately

# Optional: comma-separated origins. Empty means CORS is disabled/restricted by default.
CORS_ORIGINS=
